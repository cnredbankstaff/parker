<!doctype html>
<html lang="en" class="h-full">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Realistic VR Hockey</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/_sdk/element_sdk.js"></script>
  <style>
    body { box-sizing: border-box; margin: 0; padding: 0; }
    html, body, #app { height: 100%; width: 100%; }
    
    @keyframes ice-reflection {
      0%, 100% { opacity: 0.95; }
      50% { opacity: 1; }
    }
    
    @keyframes breath-fog {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 0.6; }
    }
    
    @keyframes goal-horn {
      0%, 100% { transform: scale(1); }
      25% { transform: scale(1.05); }
      75% { transform: scale(1.05); }
    }
    
    .vr-hockey {
      animation: ice-reflection 0.15s infinite;
    }
    
    .breath-effect {
      position: fixed;
      pointer-events: none;
      animation: breath-fog 3s ease-in-out infinite;
    }
    
    .helmet-visor {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      background: radial-gradient(ellipse at center, transparent 0%, rgba(0, 20, 50, 0.15) 100%);
      z-index: 5;
      box-shadow: inset 0 0 100px rgba(0, 10, 30, 0.2), inset 0 0 200px rgba(100, 150, 200, 0.1);
    }
    
    .stick-bottom {
      position: fixed;
      bottom: 0;
      left: 50%;
      width: 40px;
      height: 120px;
      background: linear-gradient(to bottom, rgba(200, 180, 140, 0.3) 0%, rgba(100, 80, 40, 0.4) 50%, rgba(30, 30, 30, 0.5) 100%);
      transform: translateX(-50%) rotateX(15deg);
      pointer-events: none;
      z-index: 2;
      box-shadow: inset -2px 0 5px rgba(0, 0, 0, 0.3);
      border-radius: 8px 8px 0 0;
    }
    
    .jersey-bottom {
      position: fixed;
      bottom: 80px;
      left: 50%;
      width: 140px;
      height: 100px;
      background: linear-gradient(to bottom, rgba(0, 100, 255, 0.2) 0%, rgba(0, 60, 200, 0.3) 100%);
      transform: translateX(-50%) perspective(800px) rotateX(25deg);
      pointer-events: none;
      z-index: 1;
      border-top: 2px solid rgba(0, 80, 220, 0.4);
    }
    
    .glove-left, .glove-right {
      position: fixed;
      bottom: 100px;
      width: 80px;
      height: 60px;
      background: linear-gradient(135deg, rgba(80, 60, 40, 0.4) 0%, rgba(40, 30, 20, 0.5) 100%);
      pointer-events: none;
      z-index: 1;
      border-radius: 50%;
      box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.3);
    }
    
    .glove-left {
      left: 15%;
      animation: glove-move-left 2s ease-in-out infinite;
    }
    
    .glove-right {
      right: 15%;
      animation: glove-move-right 2s ease-in-out infinite;
    }
    
    @keyframes glove-move-left {
      0%, 100% { transform: translateY(0px) rotateZ(-10deg); }
      50% { transform: translateY(-10px) rotateZ(-5deg); }
    }
    
    @keyframes glove-move-right {
      0%, 100% { transform: translateY(0px) rotateZ(10deg); }
      50% { transform: translateY(-10px) rotateZ(5deg); }
    }
  </style>
  <style>@view-transition { navigation: auto; }</style>
  <script src="/_sdk/data_sdk.js" type="text/javascript"></script>
 </head>
 <body class="m-0 overflow-hidden bg-black text-white">
  <div id="app" class="w-full h-full"><!-- Main VR View -->
   <div id="vr-arena" class="h-full w-full vr-hockey" style="background: linear-gradient(180deg, #87ceeb 0%, #b0e0e6 40%, #c0e0f0 50%, #ffffff 100%); perspective: 2000px; overflow: hidden;"><!-- Far arena (crowd, boards background) -->
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, #87ceeb 0%, #e0f0ff 50%, #f0f8ff 100%);"></div><!-- Ice surface gradient -->
    <div class="absolute bottom-0 left-0 right-0 h-1/2" style="background: linear-gradient(to bottom, 
        rgba(230, 245, 255, 0.9) 0%,
        rgba(210, 235, 255, 0.95) 20%,
        rgba(180, 220, 255, 1) 40%,
        rgba(150, 200, 255, 1) 60%,
        rgba(120, 180, 255, 1) 80%,
        rgba(100, 160, 240, 1) 100%);
        box-shadow: inset 0 -20px 60px rgba(50, 100, 200, 0.3);"></div><!-- Rink markings - center ice -->
    <div class="absolute inset-0 flex items-center justify-center"><!-- Center line -->
     <div class="absolute w-2 h-full bg-red-600 opacity-40" style="left: 50%; transform: translateX(-50%);"></div><!-- Blue lines -->
     <div class="absolute w-3 h-full opacity-30" style="left: 33.33%; background: linear-gradient(to bottom, rgba(0, 50, 200, 0.5) 0%, rgba(100, 150, 255, 0.3) 100%);"></div>
     <div class="absolute w-3 h-full opacity-30" style="right: 33.33%; background: linear-gradient(to bottom, rgba(0, 50, 200, 0.5) 0%, rgba(100, 150, 255, 0.3) 100%);"></div><!-- Center circle (faint) -->
     <div class="absolute w-96 h-48 border-4 border-red-500 rounded-full opacity-20" style="top: 50%; transform: translateY(-50%);"></div>
    </div><!-- Players container -->
    <div id="players-layer" class="absolute inset-0"></div><!-- Puck -->
    <div id="puck-layer" class="absolute inset-0">
     <div id="puck" class="absolute w-6 h-2 bg-black rounded-full" style="left: 50%; top: 50%; transform: translate(-50%, -50%); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.8), 0 0 15px rgba(255, 255, 0, 0.6);"></div>
    </div><!-- Right boards (nearby) -->
    <div class="absolute right-0 top-0 bottom-0 w-32 pointer-events-none" style="background: linear-gradient(to left, rgba(0, 100, 200, 0.8) 0%, rgba(50, 120, 200, 0.5) 30%, transparent 100%); border-left: 3px solid #004080; box-shadow: inset -10px 0 40px rgba(0, 50, 150, 0.4);"></div><!-- Left boards (nearby) -->
    <div class="absolute left-0 top-0 bottom-0 w-32 pointer-events-none" style="background: linear-gradient(to right, rgba(0, 100, 200, 0.8) 0%, rgba(50, 120, 200, 0.5) 30%, transparent 100%); border-right: 3px solid #004080; box-shadow: inset 10px 0 40px rgba(0, 50, 150, 0.4);"></div><!-- Ice shine effect -->
    <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(135deg, 
        transparent 0%, 
        rgba(255, 255, 255, 0.1) 30%,
        rgba(255, 255, 255, 0.05) 50%,
        transparent 70%
      );"></div><!-- Score overlay -->
    <div class="absolute top-12 left-1/2 transform -translate-x-1/2 text-center z-20">
     <div class="text-6xl font-black text-white" style="text-shadow: 3px 3px 10px rgba(0, 0, 0, 0.8);"><span id="score-home" class="text-blue-300">0</span> <span class="mx-6">—</span> <span id="score-away" class="text-red-300">0</span>
     </div>
     <div class="text-3xl font-bold mt-4 text-gray-100" style="text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.8);"><span id="period">Period 1</span> | <span id="game-time">20:00</span>
     </div>
    </div><!-- HUD info panels -->
    <div class="absolute bottom-32 left-8 text-white font-mono text-sm z-20" style="background: rgba(0, 0, 0, 0.6); padding: 12px 16px; border: 2px solid #00ff00; border-radius: 4px; font-weight: bold;">
     <div>
      STAMINA: <span id="stamina">100%</span>
      <div class="w-32 h-2 bg-gray-700 mt-1 rounded">
       <div id="stamina-bar" class="h-full bg-green-500 rounded" style="width: 100%;"></div>
      </div>
     </div>
     <div class="mt-3">
      SPEED: <span id="speed">0</span> mph
     </div>
     <div class="mt-2">
      PUCK: <span id="puck-dist">--</span>m away
     </div>
    </div>
    <div class="absolute bottom-32 right-8 text-white font-mono text-sm z-20" style="background: rgba(0, 0, 0, 0.6); padding: 12px 16px; border: 2px solid #00ff00; border-radius: 4px; font-weight: bold;">
     <div>
      SHOTS: <span id="shots">0</span>
     </div>
     <div class="mt-2">
      PASSES: <span id="passes">0</span>
     </div>
     <div class="mt-2">
      POSSESSION: <span id="possession">Neutral</span>
     </div>
    </div><!-- Controls display -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 text-white font-mono text-xs z-20" style="background: rgba(0, 0, 0, 0.7); padding: 12px 20px; border: 2px solid #00ff00; border-radius: 4px; text-align: center;">
     <div>
      ↑ ↓ ← → Skate | SPACE Shoot | P Pass | D Check | ESC Quit
     </div>
    </div>
   </div><!-- First-person body elements -->
   <div class="jersey-bottom"></div>
   <div class="stick-bottom"></div>
   <div class="glove-left"></div>
   <div class="glove-right"></div><!-- Helmet visor overlay -->
   <div class="helmet-visor"></div><!-- Breath fog effect -->
   <div class="breath-effect" style="top: 40%; left: 20%; width: 200px; height: 150px; background: radial-gradient(circle, rgba(200, 220, 255, 0.5) 0%, transparent 70%);"></div>
   <div class="breath-effect" style="top: 35%; right: 15%; width: 180px; height: 140px; background: radial-gradient(circle, rgba(200, 220, 255, 0.4) 0%, transparent 70%); animation-delay: 1s;"></div><!-- Goal animation -->
   <div id="goal-celebration" class="fixed inset-0 hidden z-50 pointer-events-none" style="background: radial-gradient(circle at center, rgba(255, 255, 0, 0.4) 0%, transparent 70%); animation: goal-horn 0.6s ease-out;">
    <div class="absolute top-1/3 left-1/2 transform -translate-x-1/2 text-9xl font-black text-yellow-300" style="text-shadow: 0 0 60px rgba(255, 255, 0, 1); animation: bounce 0.6s ease-out;">
     ⚡ GOAL! ⚡
    </div>
   </div>
  </div>
  <script>
    const gameState = {
      // Player
      playerX: 0,
      playerY: 30,
      playerZ: 0,
      speed: 0,
      stamina: 100,
      
      // Puck
      puckX: 0,
      puckY: 20,
      puckZ: 0,
      puckVelX: 0,
      puckVelZ: 0,
      hasPuck: false,
      
      // Score
      homeScore: 0,
      awayScore: 0,
      
      // Stats
      shots: 0,
      passes: 0,
      
      // Game time
      period: 1,
      timeRemaining: 1200,
      
      // AI
      aiPlayers: [
        { x: -20, z: -15, vx: 0, vz: 0, team: 'home', num: 11 },
        { x: 15, z: 10, vx: 0, vz: 0, team: 'home', num: 14 },
        { x: -50, z: -20, vx: 0, vz: 0, team: 'home', num: 23 },
        { x: -45, z: 20, vx: 0, vz: 0, team: 'home', num: 26 },
        { x: -80, z: 5, vx: 0, vz: 0, team: 'home', num: 31 },
        
        { x: 25, z: -12, vx: 0, vz: 0, team: 'away', num: 9 },
        { x: -10, z: 8, vx: 0, vz: 0, team: 'away', num: 19 },
        { x: -30, z: -25, vx: 0, vz: 0, team: 'away', num: 4 },
        { x: -35, z: 25, vx: 0, vz: 0, team: 'away', num: 6 },
        { x: 80, z: 0, vx: 0, vz: 0, team: 'away', num: 30 }
      ]
    };

    const keys = {};
    const defaultConfig = { game_title: 'Realistic VR Hockey' };
    let config = { ...defaultConfig };

    if (window.elementSdk) {
      window.elementSdk.init({
        defaultConfig,
        onConfigChange: async (newConfig) => { config = { ...defaultConfig, ...newConfig }; },
        mapToCapabilities: () => ({ recolorables: [], borderables: [], fontEditable: undefined, fontSizeable: undefined }),
        mapToEditPanelValues: (config) => new Map([['game_title', config.game_title]])
      });
    }

    window.addEventListener('keydown', (e) => {
      keys[e.key.toLowerCase()] = true;
      if (e.key === ' ') attemptShoot();
      if (e.key.toLowerCase() === 'p') attemptPass();
      if (e.key.toLowerCase() === 'd') attemptCheck();
      if (e.key === 'Escape') window.location.reload();
    });

    window.addEventListener('keyup', (e) => {
      keys[e.key.toLowerCase()] = false;
    });

    function updatePlayer() {
      let moveX = 0, moveZ = 0;
      const moveSpeed = 2.2;

      if (keys['arrowup'] || keys['w']) moveZ += moveSpeed;
      if (keys['arrowdown'] || keys['s']) moveZ -= moveSpeed;
      if (keys['arrowleft'] || keys['a']) moveX -= moveSpeed;
      if (keys['arrowright'] || keys['d']) moveX += moveSpeed;

      if (moveX !== 0 || moveZ !== 0) {
        gameState.playerX = Math.max(-82, Math.min(82, gameState.playerX + moveX));
        gameState.playerZ = Math.max(-95, Math.min(95, gameState.playerZ + moveZ));
        gameState.speed = Math.sqrt(moveX * moveX + moveZ * moveZ) * 16;
        gameState.stamina = Math.max(0, gameState.stamina - 0.4);
      } else {
        gameState.speed = 0;
        gameState.stamina = Math.min(100, gameState.stamina + 0.2);
      }

      // Keep puck if possessed
      if (gameState.hasPuck) {
        gameState.puckX = gameState.playerX + 6;
        gameState.puckY = 20;
        gameState.puckZ = gameState.playerZ + 4;
        gameState.puckVelX = 0;
        gameState.puckVelZ = 0;
      }
    }

    function updatePuck() {
      if (!gameState.hasPuck) {
        gameState.puckX += gameState.puckVelX;
        gameState.puckZ += gameState.puckVelZ;
        gameState.puckVelX *= 0.96;
        gameState.puckVelZ *= 0.96;

        if (Math.abs(gameState.puckX) > 82) gameState.puckVelX *= -0.85;
        if (Math.abs(gameState.puckZ) > 100) gameState.puckVelZ *= -0.85;

        gameState.puckX = Math.max(-82, Math.min(82, gameState.puckX));
        gameState.puckZ = Math.max(-100, Math.min(100, gameState.puckZ));

        const distToPuck = Math.sqrt(Math.pow(gameState.puckX - gameState.playerX, 2) + Math.pow(gameState.puckZ - gameState.playerZ, 2));
        if (distToPuck < 5) gameState.hasPuck = true;
      }
    }

    function updateAI() {
      gameState.aiPlayers.forEach(ai => {
        // Simple AI behavior - wander and chase puck
        ai.vx += (Math.random() - 0.5) * 0.5;
        ai.vz += (Math.random() - 0.5) * 0.5;
        ai.vx *= 0.95;
        ai.vz *= 0.95;

        ai.x += ai.vx;
        ai.z += ai.vz;

        ai.x = Math.max(-82, Math.min(82, ai.x));
        ai.z = Math.max(-100, Math.min(100, ai.z));

        // Chase puck occasionally
        const distToPuck = Math.sqrt(Math.pow(gameState.puckX - ai.x, 2) + Math.pow(gameState.puckZ - ai.z, 2));
        if (distToPuck < 20 && Math.random() > 0.97) {
          const angle = Math.atan2(gameState.puckZ - ai.z, gameState.puckX - ai.x);
          ai.vx = Math.cos(angle) * 1.5;
          ai.vz = Math.sin(angle) * 1.5;
        }
      });
    }

    function render() {
      const container = document.getElementById('players-layer');
      const puck = document.getElementById('puck');
      container.innerHTML = '';

      const centerX = window.innerWidth / 2;
      const centerY = window.innerHeight / 2;

      function worldToScreen(wx, wz) {
        const relX = wx - gameState.playerX;
        const relZ = wz - gameState.playerZ;
        const dist = Math.sqrt(relX * relX + relZ * relZ);
        if (dist < 0.5) return null;

        const scale = Math.max(0.1, 50 / (dist + 10));
        const sx = centerX + relX * scale * 6;
        const sy = centerY + relZ * scale * 4;

        return { x: sx, y: sy, scale: scale, dist: dist };
      }

      // Render AI players
      gameState.aiPlayers.forEach(ai => {
        const pos = worldToScreen(ai.x, ai.z);
        if (!pos || pos.dist > 120) return;

        const player = document.createElement('div');
        player.style.position = 'absolute';
        player.style.left = pos.x + 'px';
        player.style.top = pos.y + 'px';
        const size = Math.max(25, 50 * pos.scale);
        player.style.width = size + 'px';
        player.style.height = (size * 1.4) + 'px';
        player.style.transform = 'translate(-50%, -50%)';
        player.style.borderRadius = '6px';
        player.style.display = 'flex';
        player.style.alignItems = 'center';
        player.style.justifyContent = 'center';
        player.style.fontSize = (16 * pos.scale) + 'px';
        player.style.fontWeight = 'bold';
        player.style.color = 'white';
        player.style.textShadow = '0 0 8px rgba(0, 0, 0, 0.8)';

        if (ai.team === 'home') {
          player.style.background = `linear-gradient(135deg, #0066ff, #0044aa)`;
          player.style.boxShadow = `0 0 ${20 * pos.scale}px rgba(0, 100, 255, 0.7)`;
        } else {
          player.style.background = `linear-gradient(135deg, #ff3333, #cc0000)`;
          player.style.boxShadow = `0 0 ${20 * pos.scale}px rgba(255, 50, 50, 0.7)`;
        }

        player.textContent = ai.num;
        player.style.opacity = Math.min(1, pos.scale);
        container.appendChild(player);
      });

      // Render puck
      const puckPos = worldToScreen(gameState.puckX, gameState.puckZ);
      if (puckPos && puckPos.dist < 150) {
        puck.style.left = puckPos.x + 'px';
        puck.style.top = puckPos.y + 'px';
        puck.style.width = (Math.max(8, 20 * puckPos.scale)) + 'px';
        puck.style.height = (Math.max(3, 6 * puckPos.scale)) + 'px';
      }

      // Update HUD
      document.getElementById('stamina').textContent = Math.round(gameState.stamina) + '%';
      document.getElementById('stamina-bar').style.width = gameState.stamina + '%';
      document.getElementById('speed').textContent = Math.round(gameState.speed);
      document.getElementById('shots').textContent = gameState.shots;
      document.getElementById('passes').textContent = gameState.passes;
      document.getElementById('score-home').textContent = gameState.homeScore;
      document.getElementById('score-away').textContent = gameState.awayScore;

      const distToPuck = Math.sqrt(Math.pow(gameState.puckX - gameState.playerX, 2) + Math.pow(gameState.puckZ - gameState.playerZ, 2));
      document.getElementById('puck-dist').textContent = Math.round(distToPuck);
      document.getElementById('possession').textContent = gameState.hasPuck ? '🔵 YOUR TEAM' : distToPuck < 12 ? 'CONTESTED' : '🔴 OPP';
    }

    function updateTime() {
      gameState.timeRemaining--;
      if (gameState.timeRemaining <= 0) {
        gameState.timeRemaining = 1200;
        gameState.period++;
      }
      const m = Math.floor(gameState.timeRemaining / 60);
      const s = gameState.timeRemaining % 60;
      document.getElementById('game-time').textContent = `${m}:${s < 10 ? '0' : ''}${s}`;
      document.getElementById('period').textContent = `Period ${gameState.period}`;
    }

    function attemptShoot() {
      if (gameState.stamina < 15 || !gameState.hasPuck) return;
      gameState.stamina -= 22;
      gameState.shots++;
      
      const speed = 14 + Math.random() * 6;
      gameState.puckVelX = (Math.random() - 0.5) * speed;
      gameState.puckVelZ = (gameState.playerZ > 0 ? -1 : 1) * Math.sqrt(speed * speed - gameState.puckVelX * gameState.puckVelX);
      gameState.hasPuck = false;

      if (Math.random() > 0.55) {
        if (Math.abs(gameState.playerZ) < 20 && Math.random() > 0.4) {
          gameState.homeScore++;
          document.getElementById('goal-celebration').classList.remove('hidden');
          setTimeout(() => document.getElementById('goal-celebration').classList.add('hidden'), 600);
        }
      }
    }

    function attemptPass() {
      if (gameState.stamina < 10 || !gameState.hasPuck) return;
      gameState.stamina -= 12;
      gameState.passes++;
      gameState.puckVelX = (Math.random() - 0.5) * 10;
      gameState.puckVelZ = (Math.random() - 0.5) * 10;
      gameState.hasPuck = false;
    }

    function attemptCheck() {
      if (gameState.stamina < 12) return;
      gameState.stamina -= 18;
    }

    function gameLoop() {
      updatePlayer();
      updatePuck();
      updateAI();
      render();
      updateTime();
      requestAnimationFrame(gameLoop);
    }

    gameState.puckX = 0;
    gameState.puckZ = 0;
    gameLoop();
  </script>
